          "icon": "discord"
        },
        {
          "anchor": "Colab Demo",
          "href": "https://colab.research.google.com/github/PriorLabs/TabPFN/blob/main/examples/notebooks/TabPFN_Demo_Local.ipynb",
          "icon": "book"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
