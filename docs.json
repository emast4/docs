            "pages": [
              "models/overview",
              {
                "group": "Versions",
                "pages": [
                  "models/tabpfn-25",
                  "models/tabpfn-2",
                  "models/tabpfn-ts"
                ]
              }
            ]
          },
          {
            "group": "Usage Guide",
            "icon": "book",
            "pages": ["usage-guide"]
          },
          {
            "group": "Capabilities",
            "icon": "zap",
            "pages": [
              "capabilities/classification",
              "capabilities/regression",
              "capabilities/forecasting"
            ]
          },
          {
            "group": "Extensions",
            "icon": "puzzle-piece",
            "pages": [
              "extensions/many_class"
            ]
          },
          {
            "group": "Use Cases",
            "icon": "lightbulb",
            "pages": [
              "use-cases/classification",
              "use-cases/regression",
              "use-cases/forecasting"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "api-reference/openapi.json"
      },
      {
