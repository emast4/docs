{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Prior Labs",
  "colors": {
    "primary": "#101075",
    "light": "#ffffff",
    "dark": "#1e293b"
  },
  "favicon": "/favicon.png",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "navigation": {
    "global": {
      "anchors": [
        { "anchor": "GitHub", "href": "https://github.com/priorlabs/tabpfn", "icon": "github" },
        { "anchor": "Community", "href": "https://discord.com/invite/VJRuU3bSxt", "icon": "discord" },
        { "anchor": "Cookbooks", "href": "https://colab.research.google.com/github/PriorLabs/TabPFN/blob/main/examples/notebooks/TabPFN_Demo_Local.ipynb", "icon": "book" }
      ]
    },
    "tabs": [
      {
        "tab": "Documentation",
        "menu": [
          { "item": "Home", "page": "overview", "icon": "book-open" },
          { "item": "Quickstart", "page": "quickstart" }
        ],
        "groups": [
          {
            "group": "Getting Started",
            "icon": "rocket",
            "pages": ["overview", "quickstart"]
          },
          {
            "group": "Models",
            "icon": "brain-circuit",
            "expanded": false,
            "pages": [
              "models/overview",
              {
                "group": "Versions",
                "pages": [
                  "models/tabpfn-2",
                  "models/tabpfn-ts"
                ]
              }
            ]
          },
          {
            "group": "Capabilities",
            "icon": "zap",
            "pages": [
              "capabilities/classification",
              "capabilities/regression",
              {
                "group": "More Capabilities",
                "pages": [
                  "capabilities/anomaly-detection",
                  "capabilities/fine-tuning",
                  "capabilities/forecasting"
                ]
              }
            ]
          },
          {
            "group": "Extensions",
            "icon": "puzzle-piece",
            "pages": [
              "extensions/post-hoc-ensembles",
              "extensions/interpretability",
              "extensions/many-class",
              {
                "group": "All Extensions",
                "pages": [
                  "extensions/hpo",
                  "extensions/embeddings"
                ]
              }
            ]
          },
          {
            "group": "Use Cases",
            "icon": "lightbulb",
            "pages": [
              "use-cases/anomaly-detection",
              "use-cases/credit-fraud",
              "use-cases/customer-churn",
              "use-cases/drug-response"
            ]
          },
          {
            "group": "API",
            "icon": "code",
            "pages": ["api-reference/security"]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "api-reference/openapi.json",
        "pages": [
          "api-reference/security"
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/light.svg"
  },
  "navbar": {
    "links": [
      { "label": "Changelog", "href": "https://github.com/PriorLabs/TabPFN/blob/main/CHANGELOG.md" }
