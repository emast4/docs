          {
            "group": "Extensions",
            "icon": "puzzle-piece",
            "pages": [
              "extensions/post-hoc-ensembles",
              "extensions/many-class",
              "extensions/hpo",
              "extensions/rf-pfn"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
