{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Prior Labs",
  "colors": {
    "primary": "#101075",
    "light": "#ffffff",
    "dark": "#1e293b"
  },
  "favicon": "/favicon.png",
